{
  "name": "Hush — Quiet rooms for small groups",
  "short_name": "Hush",
  "description": "Text, voice, video, and screen sharing in one calm room. No accounts, no downloads.",
  "lang": "en",
  "dir": "auto",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6f6f6",
  "theme_color": "#f6f6f6",
  "categories": ["social", "communication", "productivity"],
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
