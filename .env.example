# Copy to .env and fill in — .env and .env.local are gitignored. Never put secrets in public/.
GIPHY_API_KEY=
# Server-side only. Apply supabase/migrations before starting with these set.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Base64-encoded 32-byte AES-256-GCM key. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
HUSH_FILE_ENCRYPTION_KEY=
# Optional overrides (see README):
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=./data
# UPLOADS_DIR=./uploads
# HUSH_TRUST_PROXY=0
# UPLOAD_QUOTA_BYTES=536870912
